{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Next Moca Envoy ExtProc chart values",
  "type": "object",
  "required": ["image", "existingSecret", "bridge"],
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1},
    "image": {
      "type": "object",
      "required": ["repository", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]},
        "tag": {"type": "string"},
        "digest": {"type": "string"}
      }
    },
    "existingSecret": {
      "type": "object",
      "required": ["name", "key"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "key": {"type": "string", "minLength": 1}
      }
    },
    "bridge": {
      "type": "object",
      "required": ["endpoint", "mode", "requestAdapter", "unsupportedShape", "onSelectionError", "maxContextTokens", "capacityTokens"],
      "properties": {
        "endpoint": {"type": "string", "minLength": 1},
        "mode": {"type": "string", "enum": ["shadow", "active", "quarantine", "enforce"]},
        "requestAdapter": {"type": "string", "enum": ["auto", "openai_chat", "openai_responses", "anthropic_messages", "gemini_generate_content"]},
        "unsupportedShape": {"type": "string", "enum": ["pass", "block"]},
        "onSelectionError": {"type": "string", "enum": ["pass", "block"]},
        "maxContextTokens": {"type": "integer", "minimum": 1},
        "capacityTokens": {"type": "integer", "minimum": 1}
      }
    },
    "envoyGateway": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "messageTimeout": {"type": "string", "minLength": 1},
        "failOpen": {"type": "boolean"},
        "targetRef": {
          "type": "object",
          "properties": {
            "group": {"type": "string"},
            "kind": {"type": "string"},
            "name": {"type": "string"}
          }
        }
      }
    }
  }
}
